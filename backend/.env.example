# TruthLens AI Backend Environment Configuration (Example)
# Copy this file to .env and adjust variables as needed

# Flask App Configuration
FLASK_ENV=production
FLASK_DEBUG=0
PORT=5000
HOST=0.0.0.0
# In production on Render, set a strong random secret key. Never use the dev fallback.
SECRET_KEY=change-me-to-a-secure-random-secret-in-production

# Gemini AI Configuration (REQUIRED - no implicit model fallback)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Tavily Search API (Phase 5A — primary evidence provider; preferred over Google grounding)
# Obtain a free API key at https://tavily.com
# When set, Tavily is used for evidence retrieval instead of Gemini Google Search grounding.
TAVILY_API_KEY=

# CORS Allowed Origins (Comma-separated list of trusted frontend origins, e.g. Vercel deployment URL)
# Wildcards ('*') are strictly disallowed in production.
CORS_ORIGINS=https://truthlens.vercel.app,http://localhost:3000

# Future Database / Storage Integrations (Optional)
# DATABASE_URL=postgresql://user:password@localhost:5432/truthlens
