# TruthLens AI Backend Environment Configuration (Example)
# Copy this file to .env and adjust variables as needed

# Flask App Configuration
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000
HOST=127.0.0.1
SECRET_KEY=dev-secret-key-truthlens-do-not-use-in-production

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Future External Integrations (Not required for Phase 4A)
# GEMINI_API_KEY=
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# DATABASE_URL=postgresql://user:password@localhost:5432/truthlens
